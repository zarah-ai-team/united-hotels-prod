# ---------------------------------------------------------------------------
# United Hotels — Next.js frontend (web-next)
#
# All client-readable vars MUST be prefixed NEXT_PUBLIC_ so Next inlines them
# into the browser bundle. Anything without the prefix stays server-only.
# ---------------------------------------------------------------------------

# ── BFF upstreams (SERVER-ONLY — never exposed to the browser) ──────────────
# The Next BFF (app/api/*) forwards to these. Defaults match local dev.
BACKEND_URL=http://localhost:5000
PRICING_URL=http://localhost:5050

# Client-facing base paths. The browser only ever hits this app's own BFF, so
# these stay relative (no CORS). Defaults in code: /api and /api/pricing.
NEXT_PUBLIC_API_URL=/api
# NEXT_PUBLIC_PRICING_URL=/api/pricing

# WhatsApp / phone support number (digits only, country code first — no + or
# spaces). Used by the floating chat button, nav, support page, and booking
# flow. Falls back to 905449580798 in code if unset.
NEXT_PUBLIC_SUPPORT_WHATSAPP=905449580798

# İş Bankası card payments — cosmetic toggle for the checkout UI. When "true",
# the booking page hides the "payments unavailable" notice and the manual card
# fields, and shows a "redirect to the bank's secure page" note. The actual
# redirect is driven by the backend (paymentRequired), so this only affects
# presentation — set it to match the backend's ISBANK_POS_ENABLED.
NEXT_PUBLIC_ISBANK_ENABLED=false

# ImageKit source for hotel imagery. Defaults work out-of-the-box; override
# when targeting a different bucket.
# NEXT_PUBLIC_IMAGEKIT_ENDPOINT=https://ik.imagekit.io/UnitedHotels
# NEXT_PUBLIC_IMAGEKIT_FOLDER=/hotels

# Social profile URLs — feed the Footer icons AND the Organization/TravelAgency
# sameAs schema (SEO "linked social profiles" signal). Set the real URLs.
# NEXT_PUBLIC_FACEBOOK_URL=https://www.facebook.com/...
# NEXT_PUBLIC_INSTAGRAM_URL=https://www.instagram.com/...
# NEXT_PUBLIC_X_URL=https://x.com/...
# NEXT_PUBLIC_YOUTUBE_URL=https://www.youtube.com/@...
# NEXT_PUBLIC_LINKEDIN_URL=https://www.linkedin.com/company/...

# ── SEO / metadata ──────────────────────────────────────────────────────────
# Absolute site origin — used for canonical URLs, hreflang, sitemap, robots and
# OG tags. MUST be the live https origin in production.
NEXT_PUBLIC_SITE_URL=https://bookunitedhotels.com

# Business identity for LocalBusiness/TravelAgency schema + footer (local SEO).
NEXT_PUBLIC_SUPPORT_PHONE=+90 544 958 0798
# NEXT_PUBLIC_ADDRESS_STREET=Cankurtaran, Sultanahmet
# NEXT_PUBLIC_ADDRESS_CITY=Istanbul
# NEXT_PUBLIC_ADDRESS_REGION=Istanbul
# NEXT_PUBLIC_ADDRESS_POSTAL=34122

# Google Analytics 4 measurement ID — when set, GA loads (see app/Analytics.tsx).
# NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX

# Google Search Console verification token (adds the verification meta tag).
# NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
