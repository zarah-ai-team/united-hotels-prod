# Production (served via nginx — relative paths, no CORS).
VITE_API_URL=/api
VITE_PRICING_URL=/pricing

# Local dev — use the same relative paths and let Vite's proxy
# (vite.config.ts) forward to your local backend / pricing engine.
# Override the proxy targets here if your services run on non-default ports:
# VITE_API_PROXY=http://localhost:5000
# VITE_PRICING_PROXY=http://localhost:5050

VITE_APP_NAME=United Hotels
VITE_APP_VERSION=1.0.0
