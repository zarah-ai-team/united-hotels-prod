# Backend runtime
PORT=5000
NODE_ENV=production

# Required: Postgres connection
DATABASE_URL=postgres://USER:PASSWORD@HOST:5432/DBNAME?sslmode=require
PG_SSL=true

# Required: auth secret
JWT_SECRET=replace-with-a-long-random-secret

# Required for browser API calls
CORS_ORIGIN=https://your-app-name.onrender.com

# Optional: auth flow behavior
REQUIRE_EMAIL_OTP=false

# Optional: Makecorps live pricing integration
USE_MOCK_MAKECORPS=false
MAKECORPS_API_BASE_URL=https://api.makcorps.com
MAKECORPS_API_KEY=

# Required for transactional email (welcome / verify / password reset /
# booking confirmation). Leave RESEND_API_KEY blank in dev to log emails to
# the console instead of sending them. Use a verified domain in production.
RESEND_API_KEY=
EMAIL_FROM="United Hotels <onboarding@resend.dev>"

# Public frontend URL — used to build the verify / reset links embedded
# in transactional emails.
FRONTEND_URL=https://your-app-name.onrender.com

# ImageKit — populates hotel image URLs in /api/hotels responses
IMAGEKIT_ENDPOINT=https://ik.imagekit.io/UnitedHotels
IMAGEKIT_FOLDER=/hotels

# Legacy SMTP (still used by the email-OTP flow). Optional now that the
# OTP step has been replaced with the verify-email link.
SMTP_USER=
SMTP_PASS=
MAIL_FROM="United Hotels <noreply@example.com>"
