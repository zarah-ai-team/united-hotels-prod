# pricing-engine-v2 — environment template
#
# Copy to .env and fill in the secrets (DATABASE_URL is reusable from the
# parent UnitedHotels-Merged/.env so prices are computed against the same
# data). Do NOT commit the populated .env.

# ── Runtime ─────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=5050

# ── Database (read-only access; pg.Pool only runs SELECTs) ──────────────────
DATABASE_URL=
PG_SSL=true

# ── External price source: MakCorps ─────────────────────────────────────────
MAKECORPS_API_KEY=
MAKECORPS_API_BASE_URL=https://api.makcorps.com

# ── External price source: RapidAPI hotel-prices ────────────────────────────
# Pick any of the hotel-search providers on RapidAPI (e.g. "booking-com15",
# "hotels4", "tripadvisor16"). Set the host to match the provider you signed
# up to and adapt sources/rapidapi-hotels.js if the response shape differs.
RAPIDAPI_KEY=
RAPIDAPI_HOST=booking-com15.p.rapidapi.com

# ── Where the existing engine lives, used by the bench harness ──────────────
LEGACY_API_BASE=http://localhost:5000
