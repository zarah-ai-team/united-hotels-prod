{
  "name": "pricing-engine-v2",
  "version": "0.1.0",
  "description": "Hybrid hotel pricing microservice — external median anchor + statistical adjusters. Sibling service to UnitedHotels-Merged; not a replacement until benchmark gate is cleared.",
  "private": true,
  "type": "module",
  "main": "src/server.js",
  "scripts": {
    "dev": "nodemon --watch src --ext js,json src/server.js",
    "start": "node src/server.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "bench": "node bench/runBench.js"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "axios": "^1.7.7",
    "dotenv": "^16.4.5",
    "express": "^4.21.0",
    "lru-cache": "^11.0.1",
    "pg": "^8.13.0",
    "pino": "^9.4.0",
    "pino-pretty": "^11.2.2",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "nock": "^13.5.5",
    "nodemon": "^3.1.7",
    "supertest": "^7.0.0",
    "vitest": "^2.1.1"
  }
}
