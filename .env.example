# Backend runtime
PORT=5000
NODE_ENV=production

# Required: Postgres connection
DATABASE_URL=postgres://USER:PASSWORD@HOST:5432/DBNAME?sslmode=require
PG_SSL=true

# Required: auth secret
JWT_SECRET=replace-with-a-long-random-secret

# Required for browser API calls
CORS_ORIGIN=https://your-app-name.onrender.com

# Optional: auth flow behavior
REQUIRE_EMAIL_OTP=false

# Optional: Makecorps live pricing integration
USE_MOCK_MAKECORPS=false
MAKECORPS_API_BASE_URL=https://api.makcorps.com
MAKECORPS_API_KEY=

# pricing-engine-v2 microservice integration. When ENABLED=true, the main
# backend proxies recommended-price calls to v2 (hybrid external-anchored
# pricing). On any failure (timeout, 5xx, breaker open, hotel not found)
# it transparently falls back to the legacy in-process formula.
#   - BASE_URL: in dev http://localhost:5050; in Render set to the
#     internal hostname of the pricing-engine-v2 service.
#   - TIMEOUT_MS: aborts after this many ms. 5000 covers cold-cache calls;
#     hot-cache returns in ~50ms.
#   - DEBUG=true logs `hit hybrid|analytical $X` or `miss (legacy fallback)`
#     per call — turn on when investigating fallback rate, off in prod.
PRICING_V2_ENABLED=false
PRICING_V2_BASE_URL=http://localhost:5050
PRICING_V2_TIMEOUT_MS=5000
PRICING_V2_DEBUG=false

# ── Transactional email (welcome / verify / reset / booking confirmation /
#    vendor booking notification) ──────────────────────────────────────────
# Provider resolution order: Resend → SMTP → Ethereal. Ethereal is a throwaway
# DEV inbox only; in production (NODE_ENV=production) it is disabled, so a send
# with no working provider FAILS LOUDLY instead of silently vanishing.
#
# Pick ONE for production:
#
#   Option A (recommended): Resend. Set the API key and a FROM on a domain you
#   verified in the Resend dashboard. The onboarding@resend.dev sender only
#   delivers to the account owner — use your own domain for real guests.
RESEND_API_KEY=
EMAIL_FROM="United Hotels <bookings@yourdomain.com>"
#
#   Option B: SMTP (e.g. Gmail). For Gmail you MUST use a 16-character App
#   Password (Google Account → Security → 2-Step Verification → App passwords),
#   NOT your normal login password — a normal password returns 535 BadCredentials
#   and the send fails. Set EMAIL_FROM to the same authenticated mailbox.
SMTP_USER=
SMTP_PASS=
SMTP_SERVICE=gmail
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false

# Inbox that receives messages from the /support contact form.
# Falls back to EMAIL_FROM, then SMTP_USER if unset.
SUPPORT_INBOX=hello@unitedhotels.com

# Business archive inbox — BCC'd on EVERY outgoing email (booking, cancellation,
# vendor notice, welcome, OTP, support, group). Set to '' to disable the copy.
# Defaults in code to info@united-tourism.com when unset.
EMAIL_ARCHIVE_BCC=info@united-tourism.com

# Where vendor/property booking notifications AND admin booking/cancellation
# notifications go. Falls back to SUPPORT_INBOX, then EMAIL_FROM, if unset.
BOOKING_OPS_INBOX=

# Platform-admin address that receives a notification on every new booking
# (alongside the guest confirmation and the vendor/hotel notice — 3 emails per
# booking). Defaults to admin@admin.com in code when unset.
ADMIN_NOTIFY_EMAIL=admin@admin.com

# Group-booking desk inbox — receives new group-request submissions. The
# requester also gets an automatic acknowledgement email. Falls back to
# SUPPORT_INBOX, then EMAIL_FROM, then SMTP_USER if unset.
GROUPS_INBOX=

# Public frontend URL — used to build the verify / reset links embedded
# in transactional emails. MUST be the live public origin of the Next site
# (the exact host users reach in the browser, apex vs www included). If this
# points at a stale/old host, those email links 404 (e.g. a LiteSpeed/cPanel
# "Not Found" page from old shared hosting). Local dev default: http://localhost:5173.
FRONTEND_URL=https://bookunitedhotels.com

# Public site URL used by /sitemap.xml and /robots.txt for absolute <loc>
# entries. Falls back to FRONTEND_URL, then bookunitedhotels.com if unset.
SITE_BASE_URL=https://bookunitedhotels.com

# ────────────────────────────────────────────────────────────────────────────
# Frontend env (Vite). These are read at *build time* and inlined into the
# bundle — they MUST be set on the build machine, not just the server. On
# Render, set them in the static-site service env, not the API service.
# ────────────────────────────────────────────────────────────────────────────

# Google Analytics 4 measurement ID, e.g. G-XXXXXXX. Leave blank to disable.
VITE_GA_MEASUREMENT_ID=

# Meta / Facebook Pixel ID. Leave blank to disable.
VITE_FB_PIXEL_ID=

# Social URLs — populate as each account is live. Empty values are hidden
# in the Footer and excluded from the Organization sameAs schema.
VITE_FACEBOOK_URL=
VITE_INSTAGRAM_URL=
VITE_X_URL=
VITE_YOUTUBE_URL=
VITE_LINKEDIN_URL=

# ImageKit — populates hotel image URLs in /api/hotels responses
IMAGEKIT_ENDPOINT=https://ik.imagekit.io/UnitedHotels
IMAGEKIT_FOLDER=/hotels

# Legacy SMTP (still used by the email-OTP flow). Optional now that the
# OTP step has been replaced with the verify-email link.
SMTP_USER=
SMTP_PASS=
MAIL_FROM="United Hotels <noreply@example.com>"

# ────────────────────────────────────────────────────────────────────────────
# İş Bankası Sanal POS (Payten / NestPay "EST") — 3D Pay Hosting, TranType=Auth.
# Card is entered on the bank's hosted page; raw card data never touches us.
#
# NOTE: the email from the bank only gives the *reporting dashboard* login. The
# values below are the *integration* credentials you must create separately:
# log into https://sanalpos.isbank.com.tr, define an API role-based user, and
# read off the store key + API user/password. Until STORE_KEY is set, the
# /api/payments/isbank/initiate endpoint returns 503 (it never charges blindly).
# Keep every value here secret — do NOT commit real values (.env is gitignored).
# ────────────────────────────────────────────────────────────────────────────
ISBANK_POS_ENABLED=false
ISBANK_POS_CLIENT_ID=                        # "Mağaza Numarası" (merchant no) — confirm it is the API clientid
ISBANK_POS_STORE_KEY=                       # 3D hash store key — REQUIRED, from the API user setup
ISBANK_POS_API_USER=                        # API role user — needed for refund / void / status
ISBANK_POS_API_PASSWORD=
ISBANK_POS_STORE_TYPE=3d_pay_hosting
ISBANK_POS_GATE_URL=https://sanalpos.isbank.com.tr/fim/est3Dgate
ISBANK_POS_API_URL=https://sanalpos.isbank.com.tr/fim/api
ISBANK_POS_CURRENCY=TRY                      # default settlement currency (TRY/USD/EUR/GBP)
ISBANK_POS_LANG=tr
# Public HTTPS base the bank redirects back to (must be reachable, not localhost).
# Falls back to SITE_BASE_URL / FRONTEND_URL if unset.
ISBANK_POS_CALLBACK_BASE_URL=https://bookunitedhotels.com
# Origin serving the SPA result page (/payment/result). Same as the callback in
# prod; split out for local dev where API (:5000) and frontend (:3000) differ.
# Falls back to FRONTEND_URL / SITE_BASE_URL / the callback base.
# ISBANK_POS_FRONTEND_URL=

# ── LOCAL TESTING via the built-in mock gateway (NO bank creds needed) ───────
# Set ISBANK_MOCK_GATEWAY=true (dev only — ignored when NODE_ENV=production) and
# point the URLs below at the local mock. Then click through the real checkout:
# a random card declines (→ /payment/result?status=failed); the test card
# 4355 0843 5508 4305 approves. Revert these 3 URLs before deploying.
#   ISBANK_POS_GATE_URL=http://localhost:5000/mock/isbank/gate
#   ISBANK_POS_CALLBACK_BASE_URL=http://localhost:5000
#   ISBANK_POS_FRONTEND_URL=http://localhost:3000
ISBANK_MOCK_GATEWAY=false

# ── Currency conversion (rooms priced in USD, POS settles in TRY) ────────────
# Card charges are converted to ISBANK_POS_CURRENCY (TRY) at charge time. Live
# mid-market rates are fetched from open.er-api.com and cached for FX_TTL_MS.
# FX_RATES pins exact rates (TRY per 1 unit) and is the fallback if the live
# feed is unreachable — set it so a payment never fails on FX downtime, and to
# add any FX margin you want. Format: "USD:34.5,EUR:37.2".
FX_RATES=
FX_TTL_MS=21600000

# ── Abandoned-payment cleanup ────────────────────────────────────────────────
# A card booking is held 'pending' while the guest is on the bank's page. If
# payment is never completed, the sweeper cancels it and frees the room after
# this many minutes. Sweep runs every PENDING_BOOKING_SWEEP_MS.
PENDING_BOOKING_TTL_MINUTES=30
PENDING_BOOKING_SWEEP_MS=300000
